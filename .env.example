# Banco de dados Postgres. Em produção (Vercel) isso é provisionado pela
# integração Neon e injetado automaticamente. Para rodar localmente contra o
# mesmo banco, use `vercel env pull` (gera .env.local) em vez de preencher aqui.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- IA (Dra. Anna Christina — assistente virtual) ---
# Se ANTHROPIC_API_KEY não estiver definida, o sistema usa o provedor mock
# (respostas roteirizadas, sem custo, para desenvolvimento/teste).
AI_PROVIDER="mock" # "mock" | "anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Pix ---
# Se PIX_PROVIDER="mock", o sistema gera cobranças simuladas e permite
# confirmar o pagamento manualmente via /api/payment/dev-confirm (apenas fora de produção).
PIX_PROVIDER="mock" # "mock" | "mercadopago" | "efi" | "asaas"
PIX_API_KEY=""
PIX_ENV="sandbox" # "sandbox" | "production"
PIX_WEBHOOK_SECRET=""
PIX_EXPIRATION_MINUTES="30"

# --- Tracking (opcional) ---
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

NODE_ENV="development"
